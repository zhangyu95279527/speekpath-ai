    "@speakpath/auth": "workspace:*",
    "@speakpath/learning": "workspace:*",
    "@speakpath/speaking": "workspace:*",
    "@speakpath/types": "workspace:*",
    "@speakpath/ui": "workspace:*",
    "@speakpath/utils": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "expo": "~53.0.9",
    "expo-constants": "~17.1.6",
    "expo-linking": "~7.1.5",
    "expo-modules-core": "2.5.0",
    "expo-router": "~5.1.11",
    "expo-status-bar": "~2.2.3",
    "query-string": "^7.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "~5.4.0",
