TZ=Asia/Shanghai

POSTGRES_DB=speakpath
POSTGRES_USER=speakpath
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6379

S3_ACCESS_KEY=speakpath
S3_SECRET_KEY=
S3_BUCKET=speakpath-audio
S3_PORT=9000

# bash deploy.sh 首次运行时为留空的基础设施密码和 JWT_SECRET 生成随机值。
JWT_SECRET=
# 可选。两项都填才引导创建管理账号。
ADMIN_EMAIL=
ADMIN_PASSWORD=

WEB_PORT=8081
BACKEND_PORT=8080
BIND_ADDRESS=127.0.0.1
# 远程部署时设为浏览器可访问的 S3 兼容服务 URL。
APP_STORAGE_PUBLIC_ENDPOINT=
# Docker 官方镜像的公共镜像入口。
IMAGE_REGISTRY=public.ecr.aws/docker/library
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# 留空时从数据库选模。直连 DeepSeek 时配置 LLM_PROVIDER=deepseek、LLM_MODEL=deepseek-flash。
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# 文本模型密钥（选填）。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
ARK_API_KEY=

# 兼容保留（可选）
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
GOOGLE_API_KEY=

# 语音能力厂商选择（mock/dashscope/xfyun/volcengine/tencent）：provider 直接指定使用哪个厂商
SPEECH_ASR_PROVIDER=mock
SPEECH_TTS_PROVIDER=mock
SPEECH_PRON_PROVIDER=mock
SPEECH_RT_PROVIDER=mock

# 语音密钥（能力前缀+厂商，选填）。厂商：dashscope / xfyun(三元组) / volcengine / tencent(SecretId+Key)
# 专属地址需要与你的业务空间和地域匹配。
ASR_DASHSCOPE_BASE_URL=
TTS_DASHSCOPE_BASE_URL=
RT_DASHSCOPE_BASE_URL=
PRON_DASHSCOPE_BASE_URL=https://api.cloud.ssapi.cn/auth/authorize

ASR_DASHSCOPE_API_KEY=
ASR_XFYUN_APP_ID=
ASR_XFYUN_API_KEY=
ASR_XFYUN_API_SECRET=
ASR_VOLCENGINE_API_KEY=
ASR_TENCENT_SECRET_ID=
ASR_TENCENT_SECRET_KEY=

TTS_DASHSCOPE_API_KEY=
TTS_XFYUN_APP_ID=
TTS_XFYUN_API_KEY=
TTS_XFYUN_API_SECRET=
TTS_VOLCENGINE_API_KEY=
TTS_TENCENT_SECRET_ID=
TTS_TENCENT_SECRET_KEY=

PRON_DASHSCOPE_APP_ID=
PRON_DASHSCOPE_APP_SECRET=
PRON_XFYUN_APP_ID=
PRON_XFYUN_API_KEY=
PRON_XFYUN_API_SECRET=
PRON_VOLCENGINE_API_KEY=
PRON_TENCENT_SECRET_ID=
PRON_TENCENT_SECRET_KEY=

RT_DASHSCOPE_API_KEY=
RT_XFYUN_APP_ID=
RT_XFYUN_API_KEY=
RT_XFYUN_API_SECRET=
RT_VOLCENGINE_API_KEY=
RT_TENCENT_SECRET_ID=
RT_TENCENT_SECRET_KEY=
